generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Bảng promo_codes - Luu tru ma khuyen mai va so luong con lai
model PromoCode {
  id            String    @id @default(uuid()) @db.Uuid
  code          String    @unique @db.VarChar(50)
  description   String?   @db.Text
  planType      String    @default("yearly") @map("plan_type") @db.VarChar(20)
  durationDays  Int?      @map("duration_days")
  totalUses     Int       @default(1) @map("total_uses")
  remainingUses Int       @default(1) @map("remaining_uses")
  isActive      Boolean   @default(true) @map("is_active")
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  redemptions PromoRedemption[]
  checkouts   PolarCheckout[]

  @@index([code], name: "idx_promo_codes_code")
  @@map("promo_codes")
}

/// Bảng promo_redemptions - Nhật ký kiểm toán mỗi lần redeem
model PromoRedemption {
  id               String    @id @default(uuid()) @db.Uuid
  promoCodeId      String    @map("promo_code_id") @db.Uuid
  planType         String    @default("yearly") @map("plan_type") @db.VarChar(20)
  premiumExpiresAt DateTime? @map("premium_expires_at") @db.Timestamptz
  ipAddress        String    @map("ip_address") @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.Text
  browserId        String?   @map("browser_id") @db.VarChar(255)
  fingerprint      String?   @db.VarChar(255)
  redeemedAt       DateTime  @default(now()) @map("redeemed_at") @db.Timestamptz

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@index([promoCodeId], name: "idx_redemptions_promo_code_id")
  @@index([ipAddress], name: "idx_redemptions_ip_address")
  @@index([browserId], name: "idx_redemptions_browser_id")
  @@map("promo_redemptions")
}

model PolarCheckout {
  id               String   @id @default(uuid()) @db.Uuid
  checkoutId       String   @unique @map("checkout_id") @db.VarChar(255)
  status           String   @db.VarChar(50)
  customerName     String?  @map("customer_name") @db.VarChar(255)
  customerEmail    String?  @map("customer_email") @db.VarChar(255)
  productId        String?  @map("product_id") @db.VarChar(255)
  productName      String?  @map("product_name") @db.VarChar(255)
  amount           Int?
  currency         String?  @db.VarChar(10)
  environment      String   @default("sandbox") @db.VarChar(20)
  rawPayload       Json?    @map("raw_payload")
  promoCodeId      String?  @map("promo_code_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  promoCode PromoCode? @relation(fields: [promoCodeId], references: [id])

  @@index([customerEmail], name: "idx_polar_checkout_email")
  @@index([status], name: "idx_polar_checkout_status")
  @@index([promoCodeId], name: "idx_polar_checkout_promo_code")
  @@map("polar_checkouts")
}
