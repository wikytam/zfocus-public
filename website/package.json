{
  "name": "@zfocus/website",
  "version": "0.5.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build --webpack",
    "build:cf": "pnpm build && opennextjs-cloudflare build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "db:push": "npx prisma db push",
    "lint": "oxlint .",
    "convert-logo": "node scripts/convert-logo.js",
    "clean:node_modules": "rimraf node_modules",
    "clean:turbo": "rimraf .turbo",
    "clean:bundle": "rimraf .next",
    "clean": "pnpm clean:turbo && pnpm clean:bundle && pnpm clean:node_modules",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.16.3",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-slot": "1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "^16.0.11",
    "next-intl": "^4.6.1",
    "pg": "^8.18.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "standardwebhooks": "^1.0.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.9.19",
    "dotenv": "^17.2.4",
    "postcss": "^8.5",
    "prisma": "^7.3.0",
    "tailwindcss": "^4.1.9",
    "tsx": "^4.21.0",
    "tw-animate-css": "1.3.3",
    "typescript": "^5",
    "unwasm": "^0.5.3",
    "wrangler": "^4.64.0"
  }
}
